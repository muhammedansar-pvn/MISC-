# Root GitIgnore for MISC Full-Stack Project

# Dependencies
node_modules/
**/node_modules/

# Build and Output Artifacts
.next/
**/.next/
out/
dist/
**/dist/
dist-ssr/
*.tsbuildinfo
**/*.tsbuildinfo

# Environment Variables
.env
.env.*
!.env.example

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# IDE and OS
.vscode/
!.vscode/extensions.json
.idea/
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
# Scratch
scratch/

# Uploads and User-Generated Files
uploads/*
!uploads/.gitkeep
backend/uploads/*
!backend/uploads/.gitkeep

# Database dumps and local backups
*.jsonl
*_backup.json
backend/scripts/db_dump*
backend/scripts/*_backup.json
backend/scripts/audit_output.json
backend/scripts/cleanup_manifest.json


