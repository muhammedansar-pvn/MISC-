              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"examId\": \"{{examId}}\",\n  \"examScheduleId\": \"{{examScheduleId}}\",\n  \"studentId\": \"{{studentId}}\",\n  \"subjectId\": \"{{subjectId}}\",\n  \"marksObtained\": 88,\n  \"status\": \"DRAFT\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/exams/mark-entries", "host": ["{{baseUrl}}"], "path": ["api", "exams", "mark-entries"] }
