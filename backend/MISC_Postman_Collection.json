    {
      "name": "11 Exams",
      "item": [
        {
          "name": "Create Board Exam",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Annual Board Exam 2026\",\n  \"code\": \"BE-2026\",\n  \"academicYearId\": \"{{academicYearId}}\",\n  \"startDate\": \"2026-11-01T00:00:00.000Z\",\n  \"endDate\": \"2026-11-15T00:00:00.000Z\",\n  \"status\": \"SCHEDULED\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/exams/exams", "host": ["{{baseUrl}}"], "path": ["api", "exams", "exams"] }
          }
