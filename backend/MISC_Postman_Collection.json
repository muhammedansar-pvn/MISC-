              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"paymentType\": \"EVENT_REGISTRATION\",\n  \"eventRegistrationId\": \"{{eventRegistrationId}}\",\n  \"amount\": 500,\n  \"gateway\": \"RAZORPAY\",\n  \"transactionId\": \"TXN_99887766\",\n  \"status\": \"SUCCESS\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/payments", "host": ["{{baseUrl}}"], "path": ["api", "payments"] }
          }
        }
      ]
