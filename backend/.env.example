# MISC Backend Environment Configuration

# Server Environment
PORT=5000
NODE_ENV=development
APP_URL=http://localhost:5173

# Database Connection
MONGODB_URI=mongodb://localhost:27017/misc

# Authentication
JWT_SECRET=your_jwt_secret_here

# Email Transport Provider Selection: "resend" | "smtp"
EMAIL_PROVIDER=resend

# Common Email Sender Configuration
EMAIL_FROM=MISC Portal <noreply@your-verified-domain.com>
EMAIL_FROM_NAME=MISC Portal

# Option A: Resend Integration
RESEND_API_KEY=your_resend_api_key_here
RESEND_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Option B: Nodemailer / Gmail SMTP Integration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-gmail-address@gmail.com
SMTP_PASS=your-16-digit-google-app-password
