# MISC Backend Environment Configuration

# Server Environment
PORT=5000
NODE_ENV=production
APP_URL=http://localhost:3000
# Base URL for user invitation and account setup links sent via email
SETUP_BASE_URL=http://localhost:3000/account-setup

# Database Connection
MONGODB_URI=mongodb://localhost:27017/misc

# Authentication
JWT_SECRET=your_jwt_secret_here

# Nodemailer SMTP Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-google-app-password
SMTP_FROM_NAME=MISC
SMTP_FROM_EMAIL=your-email@gmail.com

# Payment Gateway Configuration (Optional)
# Razorpay API Credentials
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
# Stripe API Secret Key
STRIPE_SECRET_KEY=your_stripe_secret_key
